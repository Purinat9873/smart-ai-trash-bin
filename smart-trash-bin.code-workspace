		},
		{
			"name": "📸 Captured Scans Gallery",
			"path": "captured_scans"
		}
	],
	"settings": {
		"files.encoding": "utf8",
		"python.defaultInterpreterPath": "python",
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"files.associations": {
			"*.ino": "cpp",
			"*.yaml": "yaml",
			"*.bat": "bat"
		},
		"workbench.colorCustomizations": {
			"titleBar.activeBackground": "#0369a1",
			"titleBar.activeForeground": "#ffffff"
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "🚀 1. Run Cloud AI Server",
				"type": "shell",
				"command": "python ai_training/cloud_ai_server.py",
				"problemMatcher": [],
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "🧪 2. Test All User Scans",
				"type": "shell",
				"command": "python ai_training/test_all_user_items.py",
				"problemMatcher": []
			},
			{
				"label": "🦾 3. Test Hardware Servos",
				"type": "shell",
				"command": ".\\TEST_SERVO.bat",
				"problemMatcher": []
			}
		]
	}
}
