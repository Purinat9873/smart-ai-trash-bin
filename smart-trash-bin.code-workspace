{
	"folders": [
		{
			"name": "🗑️ Smart AI Trash Bin (Root)",
			"path": "."
		},
		{
			"name": "🧠 AI Training & Server",
			"path": "ai_training"
		},
		{
			"name": "⚡ ESP32-S3 Firmware",
